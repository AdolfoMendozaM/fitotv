<?xml version="1.0" encoding="utf-8"?>
<!-- Muchas listas y canales usan http sin cifrar; hay que permitirlos para que se reproduzcan. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
